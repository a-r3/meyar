#!/usr/bin/env bash
# MEYAR repo-local governance hook. After the one-time repository
# bootstrap, blocks a direct push of local `main` onto remote `main` —
# normal development goes through a task branch + PR. See
# .claude/rules/git-workflow.md.
set -euo pipefail

if [ "${MEYAR_ALLOW_MAIN_PUSH:-0}" = "1" ]; then
  exit 0
fi

remote_name="${1:-origin}"
protected_ref="refs/heads/main"
blocked=0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  if [ "$remote_ref" = "$protected_ref" ]; then
    blocked=1
  fi
done

if [ "$blocked" = "1" ]; then
  echo "" >&2
  echo "MEYAR governance: push a task branch and merge through PR." >&2
  echo "Direct pushes to '${remote_name} main' are blocked after repository bootstrap." >&2
  echo "" >&2
  echo "  git push -u origin <task-branch>" >&2
  echo "  gh pr create --base main --head <task-branch>" >&2
  echo "" >&2
  echo "Owner-only emergency bypass: MEYAR_ALLOW_MAIN_PUSH=1 git push ..." >&2
  echo "" >&2
  exit 1
fi

exit 0
