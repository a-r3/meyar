# Non-production local development defaults. Never place real secrets here.
MEYAR_ENV=development
MEYAR_DATABASE_URL=postgresql+asyncpg://meyar:meyar_dev_password@localhost:55719/meyar
MEYAR_OLLAMA_BASE_URL=http://127.0.0.1:11434
MEYAR_OLLAMA_MODEL=qwen3:0.6b
MEYAR_MAX_UPLOAD_BYTES=10485760
MEYAR_RATE_LIMIT_PER_MINUTE=60
MEYAR_INFERENCE_CONCURRENCY=1
MEYAR_STORAGE_ROOT=./var/storage
MEYAR_LLM_PROVIDER=ollama
MEYAR_LLM_TIMEOUT_SECONDS=60
MEYAR_LLM_MAX_INPUT_CHARS=20000
