# Non-production local development defaults. Never place real secrets here.
MEYAR_ENV=development
MEYAR_DATABASE_URL=postgresql+asyncpg://meyar:meyar_dev_password@localhost:55719/meyar
MEYAR_OLLAMA_BASE_URL=http://127.0.0.1:11434
MEYAR_OLLAMA_MODEL=qwen3:0.6b
MEYAR_MAX_UPLOAD_BYTES=10485760
MEYAR_RATE_LIMIT_PER_MINUTE=60
MEYAR_INFERENCE_CONCURRENCY=1
MEYAR_STORAGE_ROOT=./var/storage
MEYAR_LLM_PROVIDER=ollama
MEYAR_LLM_TIMEOUT_SECONDS=120
MEYAR_LLM_MAX_INPUT_CHARS=20000
MEYAR_EMBEDDING_PROVIDER=ollama
MEYAR_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
MEYAR_EMBEDDING_DIMENSIONS=768
MEYAR_EMBEDDING_TIMEOUT_SECONDS=60
MEYAR_EMBEDDING_MAX_INPUT_CHARS=20000
MEYAR_UI_COOKIE_SECURE=false
MEYAR_UI_SESSION_TTL_HOURS=8
# Signs the short-lived pending-login token used only when a human user
# has more than one active tenant membership (Slice 1, issue #30).
# Production requires an explicit, non-default value here.
MEYAR_PENDING_LOGIN_SECRET=dev-insecure-pending-login-secret-change-me
# Folder-import file-stability window (seconds) — a discovered file
# modified more recently than this is skipped for that scan, not FAILED.
MEYAR_FOLDER_STABILITY_SECONDS=60
